# Static Next.js export: every route is a directory with its own index.html
# (trailingSlash: true). Apache (mod_dir) redirects /about to /about/ by itself,
# so the old SPA fallback to index.html is no longer needed.
DirectoryIndex index.html
Options -Indexes

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed build assets never change
  <FilesMatch "^.+\.(js|css|woff2|jpg|jpeg|png|svg|webp|avif)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
